{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2015",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["DOM", "es5"],
    "allowJs": true,
    "declaration": true,
    "outDir": "./dist/cjs",
    "rootDir": "./src" 
  },
  "include": [
    "src/bin/**/*", 
    "src/lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.*"
  ]
}
