{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2015",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["DOM", "es5"],
    "allowJs": true,
    "declaration": true,
    "outDir": "./dist/cjs",  // Compiled output will go to the root-level bin folder
    "rootDir": "./src",  // Root directory for source files (includes both bin and lib)
  },
  "include": [
    "src/bin/**/*",  // Include all files from src/bin
    "src/lib/**/*"   // Include all files from src/lib
  ],
  "exclude": [
    "node_modules",  // Exclude node_modules folder
    "src/lib/test.ts"
  ]
}
