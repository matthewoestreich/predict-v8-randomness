{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",  // Compiled output will go to the root-level bin folder
    "rootDir": "./src",  // Root directory for source files (includes both bin and lib)
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": "./",  // Use base URL from the root of src
    "paths": {
      "@lib/*": ["lib/*"],  // Allow imports from lib using @lib/
      "@bin/*": ["bin/*"]   // Optionally allow imports from bin using @bin/
    }
  },
  "include": [
    "src/bin/**/*",  // Include all files from src/bin
    "src/lib/**/*"   // Include all files from src/lib
  ],
  "exclude": [
    "node_modules",  // Exclude node_modules folder
    "src/lib/test.ts"
  ]
}
